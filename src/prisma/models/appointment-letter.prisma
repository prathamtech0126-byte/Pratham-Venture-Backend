enum SalaryPaymentFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  ANNUALLY
}

model AppointmentLetter {
  id                     Int                     @id @default(autoincrement())
  company                String
  companyWebsite         String?
  companyEmail           String?
  companyPhone           String?
  letterDate             DateTime?
  recipientName          String
  recipientAddress       String?
  jobTitle               String
  startDate              DateTime?
  jobResponsibilities    String?
  salaryAmount           Float?
  salaryPaymentFrequency SalaryPaymentFrequency?
  salaryEffectiveDate    DateTime?
  signatoryName          String?
  employeeRefId          Int?
  employee               Employee?               @relation(fields: [employeeRefId], references: [id], onDelete: SetNull)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?

  @@index([recipientName])
  @@index([jobTitle])
  @@index([deletedAt])
  @@index([employeeRefId])
}
