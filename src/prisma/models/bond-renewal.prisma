/// Employment Bond Renewal — HR workspace only (36-page agreement; clauses come from the frontend template)
model BondRenewal {
  id               Int       @id @default(autoincrement())
  company          String
  letterDate       DateTime?
  employeeName     String
  employeeAddress  String?
  designation      String
  department       String?
  workLocation     String?
  effectiveDate    DateTime?
  /// e.g. "INR 2.28 Lakhs Per Annum"
  compensation     String?
  /// e.g. "Twelve (12) Months"
  bondDuration     String?
  /// Clause 2.1 reporting authority
  reportingTo      String?
  /// Schedule A duties (HTML, defaults to the designation JD)
  scheduleA        String?   @db.Text
  /// Schedule B salary structure (HTML)
  scheduleB        String?   @db.Text
  includeSignature Boolean   @default(true)
  employeeRefId    Int?
  employee         Employee? @relation(fields: [employeeRefId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  workspace        Workspace @default(HR)

  @@index([employeeName])
  @@index([deletedAt])
  @@index([workspace, deletedAt])
  @@index([employeeRefId])
}
