model OfferLetter {
  id             Int       @id @default(autoincrement())
  company        String
  candidateName  String
  position       String
  department     String?
  annualCtc      Float?
  joiningDate    DateTime?
  workLocation   String?
  letterDate     DateTime?
  hrName         String?
  hrDesignation  String?
  contentMode    DocumentContentMode @default(TEMPLATE)
  customContent  String?             @db.Text
  employeeRefId  Int?
  employee       Employee? @relation(fields: [employeeRefId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([candidateName])
  @@index([deletedAt])
  @@index([employeeRefId])
}
