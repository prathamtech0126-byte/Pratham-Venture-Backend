model JobDutyCertificate {
  id                   Int                 @id @default(autoincrement())
  company              String
  employeeName         String
  registrationNo       String?
  designation          String?
  employmentStartDate  DateTime?
  employmentEndDate    DateTime?
  workResponsibilities String?
  monthlyGrossSalary   Float?
  performanceRemarks   String?
  certificateDate      DateTime?
  authorizedSignatory  String?
  contentMode          DocumentContentMode @default(TEMPLATE)
  customContent        String?             @db.Text
  employeeRefId        Int?
  employee             Employee?           @relation(fields: [employeeRefId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?
  workspace            Workspace           @default(ADMIN)

  @@index([employeeName])
  @@index([registrationNo])
  @@index([deletedAt])
  @@index([workspace, deletedAt])
  @@index([employeeRefId])
}
